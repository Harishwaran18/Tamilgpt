# ── TamilGPT 2.0 configuration ─────────────────────────────────────────────
# Everything below is optional. With no keys the app runs fully offline using
# the curated knowledge base and deterministic answer composer.

TAMILGPT_ENV=development
TAMILGPT_HOST=0.0.0.0
TAMILGPT_PORT=8000
TAMILGPT_LOG_LEVEL=INFO

# LLM provider: offline | openai | gemini | ollama
TAMILGPT_LLM_PROVIDER=offline

# OpenAI-compatible endpoint (OpenAI, Azure, vLLM, LM Studio, Groq…)
TAMILGPT_OPENAI_API_KEY=
TAMILGPT_OPENAI_BASE_URL=https://api.openai.com/v1
TAMILGPT_OPENAI_MODEL=gpt-4o-mini

# Google Gemini
TAMILGPT_GEMINI_API_KEY=
TAMILGPT_GEMINI_MODEL=gemini-1.5-flash

# Local Ollama
TAMILGPT_OLLAMA_BASE_URL=http://localhost:11434
TAMILGPT_OLLAMA_MODEL=llama3.1

# Safety / limits
TAMILGPT_API_KEY=
TAMILGPT_ENABLE_DOCS=true
TAMILGPT_RATE_LIMIT_PER_MINUTE=60
TAMILGPT_MAX_QUESTION_CHARS=1200
TAMILGPT_MAX_HISTORY_TURNS=8
TAMILGPT_MAX_BODY_BYTES=64000
TAMILGPT_REQUEST_TIMEOUT_SECONDS=30
TAMILGPT_ALLOWED_ORIGINS=*
